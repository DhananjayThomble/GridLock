{
  "enabled": true,
  "name": "No Auto Push — Review First",
  "description": "Intercepts GitHub MCP tool calls (PR creation, issue mutations) to ensure the agent summarizes changes and gets user approval before modifying the remote repository.",
  "version": "2",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      ".*create_pr.*",
      ".*create_issue.*",
      ".*merge.*"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "STOP. Before creating a PR, issue, or merging anything on GitHub, you MUST: 1) Summarize ALL changes with file paths and descriptions, 2) Provide an unbiased review noting strengths and concerns, 3) List test results, 4) Ask the user for explicit permission. Do NOT proceed without user approval."
  }
}