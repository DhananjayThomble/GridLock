{
  "version": "v1",
  "hooks": [
    {
      "name": "Backend Tests on Change",
      "description": "Runs Jest backend tests when backend source files are edited to catch regressions early.",
      "trigger": "PostFileSave",
      "matcher": "(backend/controllers/.*[^/]*\\.js$|backend/utils/.*[^/]*\\.js$|backend/services/.*[^/]*\\.js$|backend/models/.*[^/]*\\.js$|backend/middleware/.*[^/]*\\.js$|backend/stores/.*[^/]*\\.js$)",
      "action": {
        "type": "command",
        "command": "cd backend && npx jest --runInBand --silent"
      },
      "timeout": 120,
      "enabled": true
    }
  ]
}
