{
  "enabled": true,
  "name": "Frontend Build Check",
  "description": "Verifies the frontend builds successfully. Triggered manually to avoid slowing down rapid iteration.",
  "version": "2",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "cd frontend && npx vite build",
    "timeout": 60
  }
}