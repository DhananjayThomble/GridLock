{
  "name": "gridlock",
  "version": "1.0.0",
  "description": "GridLock — multiplayer territory game",
  "private": true,
  "scripts": {
    "test:e2e":         "TEST_BASE_URL=http://localhost/beta npx playwright test --config=playwright.config.js",
    "test:e2e:local":   "bash scripts/test-e2e-local.sh",
    "test:e2e:report":  "npx playwright show-report playwright-report",
    "test:e2e:debug":   "TEST_BASE_URL=http://localhost/beta npx playwright test --config=playwright.config.js --debug",
    "test:backend":     "cd backend && npm test",
    "test:backend:all": "cd backend && npm run test:all",
    "test:all":         "npm run test:backend && npm run test:e2e:local",
    "smoke":            "node scripts/smoke-test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
