{
  "name": "gridlock",
  "version": "2.3.0",
  "description": "GridLock — multiplayer territory game",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test:e2e": "TEST_BASE_URL=http://localhost/beta npx playwright test --config=playwright.config.js",
    "test:e2e:local": "bash scripts/test-e2e-local.sh",
    "test:e2e:beta": "TEST_ENV=beta npx playwright test --config=playwright.config.js",
    "test:e2e:prod": "TEST_ENV=prod npx playwright test --config=playwright.config.js",
    "test:e2e:report": "npx playwright show-report playwright-report",
    "test:e2e:debug": "TEST_BASE_URL=http://localhost/beta npx playwright test --config=playwright.config.js --debug",
    "test:backend": "cd backend && npm test",
    "test:backend:all": "cd backend && npm run test:all",
    "test:all": "npm run test:backend && npm run test:e2e",
    "test:local": "bash scripts/test-local.sh",
    "smoke": "node scripts/smoke-test.js",
    "prepare": "husky",
    "visual-qa": "npx playwright test e2e/visual-qa.spec.js --config=playwright.config.js --timeout 3600000"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1024.0",
    "@playwright/test": "^1.40.0",
    "husky": "^9.1.7",
    "mongodb": "^7.1.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0"
  }
}
