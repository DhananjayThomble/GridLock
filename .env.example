# GridLock Environment Variables

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/gridlock

# Redis connection (optional — falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379

# Server port
PORT=3001

# Admin API key for protected endpoints (e.g., season reset)
# Generate a secure random key: openssl rand -hex 32
ADMIN_API_KEY=

# Trusted reverse proxy IPs (comma-separated) for X-Forwarded-For parsing
# TRUSTED_PROXY_IPS=

# VAPID keys for Web Push notifications
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@example.com
