# GridLock Frontend Environment Variables

# Backend API / Socket.IO URL
# Local same-origin/proxy setup: leave empty
# Separate-origin deploy: set to your backend API domain
VITE_SOCKET_URL=

# Base URL for REST API requests (Leaderboard, etc.)
# Usually the same as VITE_SOCKET_URL; falls back to VITE_SOCKET_URL if unset
VITE_API_BASE_URL=

# Public site URL (used for OG/meta tags in production builds)
VITE_SITE_URL=

# VAPID public key for push notifications (optional — can also be fetched from backend)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# DSN override for the deploy build (production has a project default).
# Set an empty value to disable when invoking scripts/build-frontend.sh directly.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_REPLAY_ON_ERROR_RATE=0
VITE_SENTRY_DSN=

# PostHog analytics (optional — leave empty to disable)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
