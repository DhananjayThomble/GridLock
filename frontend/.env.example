# GridLock Frontend Environment Variables

# Backend API / Socket.IO URL
# Local same-origin/proxy setup: leave empty
# Hosted frontend (e.g. GitHub Pages): set to your backend API domain
VITE_SOCKET_URL=

# Base URL for REST API requests (Leaderboard, etc.)
# Usually the same as VITE_SOCKET_URL; falls back to VITE_SOCKET_URL if unset
VITE_API_BASE_URL=

# Public site URL (used for OG/meta tags in production builds)
VITE_SITE_URL=

# VAPID public key for push notifications (optional — can also be fetched from backend)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Sentry DSN for error tracking (optional — leave empty to disable)
VITE_SENTRY_DSN=

# PostHog analytics (optional — leave empty to disable)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
