# Production environment — used by Vite during build
VITE_SOCKET_URL=https://api.gridlock.pro
VITE_API_BASE_URL=https://api.gridlock.pro
VITE_SITE_URL=https://gridlock.pro
# Optional: error tracking (Sentry) and analytics (PostHog) are off unless
# these are set at build time, e.g. as GitHub Actions variables:
#   VITE_SENTRY_DSN, VITE_POSTHOG_KEY, VITE_POSTHOG_HOST
VITE_APP_VERSION=2.2.3
