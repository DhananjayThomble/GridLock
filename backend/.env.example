# Backend Environment Variables

NODE_ENV=production
PORT=5000
LOG_LEVEL=INFO

# Database persistence (required for active-game recovery)
MONGO_URI=mongodb://localhost:27017/gridlock

# Optional Redis (recommended for horizontal scaling + shared disconnect state)
# Example: redis://localhost:6379
REDIS_URL=

# Comma-separated CORS origins (REQUIRED in production; leave empty defaults to "*" which is insecure)
# Example: https://gridlock.pro,https://beta.gridlock.pro
CORS_ORIGIN=

# Sentry error tracking
SENTRY_DSN=

# Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:noreply@gridlock.app

# Google OAuth
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=<generate-a-secure-random-secret>

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173
