# Backend Environment Variables

PORT=5000
NODE_ENV=production
LOG_LEVEL=INFO

# Database persistence (required for active-game recovery)
MONGO_URI=mongodb://localhost:27017/gridlock

# Optional Redis (recommended for horizontal scaling + shared disconnect state)
# Example: redis://localhost:6379
REDIS_URL=

# Comma-separated CORS origins (REQUIRED in production; leave empty defaults to "*" which is insecure)
# Example: https://gridlock.snapurl.in,https://dhananjaythomble.github.io
CORS_ORIGIN=
