# Backend Environment Variables

PORT=5000
NODE_ENV=production
LOG_LEVEL=INFO

# Database persistence (required for active-game recovery)
MONGO_URI=mongodb://localhost:27017/gridlock

# Optional Redis (recommended for horizontal scaling + shared disconnect state)
# Example: redis://localhost:6379
REDIS_URL=

# Comma-separated CORS origins (REQUIRED in production; leave empty defaults to "*" which is insecure)
# Example: https://gridlock.snapurl.in,https://dhananjaythomble.github.io
CORS_ORIGIN=

# Push Notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:noreply@gridlock.app

# Google OAuth
GOOGLE_CLIENT_ID=981230117350-4kfn5q4umm6qr5eej4eeahpl2s7t4mb4.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=<your-jwt-secret>

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173
