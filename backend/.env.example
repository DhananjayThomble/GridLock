# Backend
PORT=5000
NODE_ENV=production
LOG_LEVEL=INFO

# Database persistence (required for active-game recovery)
MONGO_URI=mongodb://localhost:27017/gridlock

# Optional Redis (recommended for horizontal scaling + shared disconnect state)
# Example: redis://localhost:6379
REDIS_URL=

# Comma-separated CORS origins (REQUIRED in production; leaving empty may default to "*" and is insecure)
# Example: https://gridlock.example.com,https://beta.gridlock.example.com
CORS_ORIGIN=
