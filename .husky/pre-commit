#!/bin/sh
set -e

# Lint only staged frontend files (not the entire src/ directory)
STAGED_FRONTEND=$(git diff --cached --name-only --diff-filter=d -- 'frontend/src/*.js' 'frontend/src/*.jsx' 'frontend/src/**/*.js' 'frontend/src/**/*.jsx' | sed 's|^frontend/||')

if [ -n "$STAGED_FRONTEND" ]; then
  echo "🔍 Linting staged frontend files..."
  cd frontend && echo "$STAGED_FRONTEND" | xargs npx eslint --quiet
  cd ..
fi

# Run backend tests if any backend files are staged
STAGED_BACKEND=$(git diff --cached --name-only --diff-filter=d -- 'backend/**')

if [ -n "$STAGED_BACKEND" ]; then
  echo "🧪 Running backend tests..."
  cd backend && npm test --silent
fi

echo "✅ Pre-commit checks passed"
